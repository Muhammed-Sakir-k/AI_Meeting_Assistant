# Database Configuration
# DB_TYPE can be 'mysql' or 'sqlite'
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_password_here
DB_NAME=ai_meeting_assistant

# Machine Learning Models Configuration
# Whisper models: tiny, base, small, medium, large
WHISPER_MODEL=base
# Device options: 'cpu' or 'cuda' (if GPU is available)
WHISPER_DEVICE=cpu

# Hugging Face models for NLP & Summarization
# We can configure lightweight models for dev performance
NLP_MODEL=bert-base-uncased
SUMMARIZATION_MODEL=sshleifer/distilbart-cnn-12-6

# Storage Paths
UPLOAD_DIR=uploads
MODEL_DIR=models

# Server Configuration
HOST=127.0.0.1
PORT=8000
